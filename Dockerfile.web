# syntax=docker/dockerfile:1

# ---------- build: compile the SPA (relative /api/v1 base URL is kept, so the
# browser talks to the same origin and nginx proxies /api/ to the API service) ----------
FROM node:22-alpine AS build
WORKDIR /app

# Vite inlines import.meta.env at build time. The browser must talk to the same
# origin (nginx proxies /api/), and the in-browser mock adapter must be off so
# the SPA reads the real API instead of bundled demo data.
ARG VITE_API_BASE_URL=/
ARG VITE_USE_MOCKS=false
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_USE_MOCKS=$VITE_USE_MOCKS

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .
RUN npm run build

# ---------- runtime: nginx terminates TLS and serves the static bundle ----------
FROM nginx:1.27-alpine AS runtime

# The official image runs envsubst over /etc/nginx/templates/*.template on boot,
# which is how ${DOMAIN} is injected without rebuilding the image.
COPY deploy/nginx/nginx.conf /etc/nginx/nginx.conf
COPY deploy/nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80 443

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q --spider http://127.0.0.1/healthz || exit 1

STOPSIGNAL SIGQUIT
