# Quali production environment.
# Copy to .env (git-ignored) on the server, fill in real values, then:
#   chmod 600 .env
# Never commit .env. Never bake these values into an image.

# --- Public identity (must match the DNS record for the Vultr instance) ---
DOMAIN=quali.example.com
APP_URL=https://quali.example.com

# Comma-separated browser origins allowed to call the API. Keep it to the real
# frontend origin(s) the browser actually uses; the SPA is served same-origin
# through nginx, so normally this is just APP_URL.
ALLOWED_ORIGINS=https://quali.example.com

# --- TLS (used only by the initial certificate request) ---
ACME_EMAIL=ops@example.com
# Optional: use the staging CA while testing to avoid Let's Encrypt rate limits.
# ACME_STAGING=1

# --- Reverse proxy ports ---
HTTP_PORT=80
HTTPS_PORT=443

# --- Image tag used for build/rollback. Set per deploy (e.g. a timestamp or SHA). ---
IMAGE_TAG=local

# --- Optional AI provider key. Leave empty to run without external AI calls. ---
GEMINI_API_KEY=

# --- Runtime limits (milliseconds) ---
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=20000
KEEP_ALIVE_TIMEOUT_MS=65000
SHUTDOWN_TIMEOUT_MS=10000
