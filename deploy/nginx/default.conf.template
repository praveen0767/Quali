# Rendered at container start by the official nginx image's envsubst step.
# Only ${DOMAIN} is substituted (the entrypoint limits envsubst to defined env
# vars, so nginx variables like $host and $uri are left untouched).

# Docker's embedded DNS lets nginx re-resolve the API container after restarts.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # Plain-HTTP health endpoint for load balancers / orchestrators and for
    # pre-TLS smoke tests. Never proxies application data over cleartext.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # ACME HTTP-01 challenges for initial issuance and renewals.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    root /usr/share/nginx/html;
    index index.html;

    # Application-level limit is 25 MB (MAX_DOCUMENT_SIZE_BYTES); leave room for
    # multipart framing, then reject anything larger at the edge.
    client_max_body_size 26m;
    client_body_timeout 30s;
    client_body_buffer_size 256k;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Same-origin API proxy. proxy_pass uses a variable so nginx re-resolves the
    # api service through Docker DNS instead of caching a stale container IP.
    location /api/ {
        set $api_upstream http://api:8000;
        proxy_pass $api_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        # Buffer uploads at the edge so the Node request timeout does not fire
        # while a slow client is still streaming a document.
        proxy_request_buffering on;
        client_body_buffer_size 1m;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
    }

    location = /index.html {
        expires -1;
    }

    # SPA client-side routing fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
